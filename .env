# Docker settings for stable-diffusion-webui. Read by docker-compose.yml.

# HTTPS port published by nginx -> https://localhost:8443
# Set to 443 for a plain https://localhost, and see docker/nginx/nginx.conf if
# you also want the HTTP->HTTPS redirect.
HTTPS_PORT=8443

# Baked into the self-signed cert on first boot. If you reach this box by
# hostname or LAN IP, add them to TLS_SAN or the browser will reject the cert
# even after you accept the exception.
TLS_COMMON_NAME=localhost
TLS_SAN=DNS:localhost,DNS:*.local,IP:127.0.0.1

# Which nginx config the proxy mounts. Point this at your own copy when reusing
# this compose file for a different service.
#NGINX_CONF=./docker/nginx/nginx.conf

# Plain-HTTP port for the WebUI, bound to 127.0.0.1 only (see docker-compose.yml)
# -> http://localhost:7860. Handy for debugging; nginx is the real entrypoint.
WEBUI_PORT=7860

# Extra arguments appended to launch.py. The container already passes
# --data-dir /data --listen --port 7860, so only add things on top of that.
#
#   --no-download-sd-model  the old runwayml/stable-diffusion-v1-5 auto-download
#                           target is gone from HuggingFace; put your own
#                           checkpoint in ./data/models/Stable-diffusion instead
#   --xformers              xformers is already installed in the image
#   --api                   enable the /sdapi/v1 REST API
#   --enable-insecure-extension-access   allow installing extensions from the UI
#                           (needed because the UI is bound to 0.0.0.0)
#
# Other things you may want:
#   --gradio-auth user:pass    password-protect the UI
#   --medvram / --lowvram      for GPUs under ~8GB / ~4GB VRAM
#   --skip-prepare-environment fastest possible start; skips the dependency
#                              check entirely. Remove it after installing a new
#                              extension so its install.py can run once.
COMMANDLINE_ARGS=--no-download-sd-model --xformers --api --enable-insecure-extension-access --theme=dark

# Set to 1 to disable the TCMalloc allocator preload.
#NO_TCMALLOC=1

# Source repos launch.py clones into /app/repositories. The image already points
# STABLE_DIFFUSION_REPO at a maintainer fork, because the upstream
# Stability-AI/stablediffusion repo was deleted and now 404s mid-build. Set this
# if you'd rather use a different mirror - it must contain the commit pinned in
# modules/launch_utils.py (cf1d67a6fd5ea1aa600c4df58e5b47da45f6bdbf).
#STABLE_DIFFUSION_REPO=https://github.com/w-e-w/stablediffusion.git

# Mirror to use for HuggingFace downloads.
#HF_ENDPOINT=https://huggingface.co
